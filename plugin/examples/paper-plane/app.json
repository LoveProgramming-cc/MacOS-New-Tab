{
  "id": "paper-plane-mail",
  "name": "纸飞机",
  "version": "1.3.1",
  "kind": "app",
  "runtime": "web",
  "description": "Letters to your future self. Write a few lines, fold them into a paper plane and throw it off the desktop; on the day you chose it glides back in and lands on the Dock — and the system tells you it has, even when no new tab is open.",
  "icon": "assets/icon.png",
  "accentColor": "orange",
  "permissions": [
    "storage",
    "statusItem",
    "notifications",
    "widgets"
  ],
  "window": {
    "width": 492,
    "height": 572,
    "titlebar": "none",
    "material": "transparent",
    "level": "floating",
    "showInDock": false,
    "resizable": false
  },
  "entry": {
    "html": "src/index.html",
    "css": "src/style.css",
    "script": [
      "src/flight.js",
      "src/main.js"
    ]
  },
  "locales": {
    "zh-CN": "locales/zh-CN.json",
    "en-US": "locales/en-US.json",
    "ko-KR": "locales/ko-KR.json",
    "ja-JP": "locales/ja-JP.json"
  },
  "widgets": [
    {
      "id": "sky",
      "title": "Paper Planes",
      "titleKey": "widgetTitle",
      "sizes": [
        "small",
        "medium"
      ]
    }
  ]
}